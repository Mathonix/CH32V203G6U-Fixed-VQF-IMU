{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // gyroc: CH32V203G6U AHRS UART web host (firmware 20261003h protocol) — separate Worker
  "name": "gyroc-233688",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "routes": [{ "pattern": "gyroc.233688.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
